# ─── Client Configuration ────────────────────────────────────────────────────

# Socket.IO server URL.
# Must match the address and port the server is listening on.
VITE_SERVER_URL=http://localhost:3001

# Secret token sent in socket.handshake.auth.token on every connection.
# Must match CLIENT_SECRET_KEY on the server.
# Leave empty to connect without authentication (development only).
VITE_CLIENT_SECRET_KEY=change-me-in-production
