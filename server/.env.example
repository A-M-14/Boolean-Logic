# ─── Server Configuration ────────────────────────────────────────────────────

# Port the Socket.IO server listens on
PORT=3001

# Allowed client origin for CORS and WebSocket upgrades.
# Must match the URL the browser loads the client from.
CLIENT_URL=http://localhost:5173

# Secret token that clients must pass in socket.handshake.auth.token.
# Leave empty to disable authentication (development only).
CLIENT_SECRET_KEY=change-me-in-production
